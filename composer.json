{
    "name": "uams-web/medicine-uams",
    "description": "UAMS College of Medicine WordPress child theme of uams-2016.",
    "type": "wordpress-theme",
    "require": {
        "php": ">=8.2"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "php-stubs/wordpress-stubs": "^6.8",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.8",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "scripts": {
        "test": "pest",
        "mutate": "pest tests/Unit/FunctionsTest.php tests/Unit/ThinstripTest.php --mutate --path=functions.php,thinstrip.php",
        "stan": "phpstan analyse --no-progress --memory-limit=2G",
        "pint": "pint",
        "refactor": "rector",
        "refactor:sweep": "rector --clear-cache --config=rector-sweep.php",
        "test:pint": "pint --test",
        "test:refactor": "rector --dry-run",
        "test:refactor:sweep": "rector --dry-run --clear-cache --config=rector-sweep.php"
    },
    "scripts-descriptions": {
        "test": "Run the Pest unit suite: no WordPress, no database, WordPress functions mocked with Brain Monkey.",
        "mutate": "Run Pest mutation testing over functions.php and thinstrip.php, naming the test files so the Patchwork bootstrap does not break the mutant children.",
        "stan": "Run PHPStan.",
        "pint": "Format first-party PHP with Pint.",
        "refactor": "Apply Rector's gating profile.",
        "refactor:sweep": "Apply Rector's sweep profile; review the diff.",
        "test:pint": "Check formatting with Pint without changing files.",
        "test:refactor": "Preview Rector's gating profile.",
        "test:refactor:sweep": "Preview Rector's sweep profile."
    }
}
